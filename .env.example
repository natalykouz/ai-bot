# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Ключ API OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# модель OpenAI по умолчанию (fallback если пользователь не выбрал)
OPENAI_MODEL=gpt-4o-mini

# Telegram user_id администраторов через запятую (см. @userinfobot).
# Только они могут менять пароль командой /setpassword.
# Используется один раз — при первом запуске, для создания data/auth.json.
ADMIN_IDS=123456789,987654321

# Начальный пароль для доступа к боту.
# Используется один раз — при первом запуске, для создания data/auth.json.
# Дальше пароль меняется командой /setpassword и хранится (в виде хеша) в data/auth.json.
BOT_PASSWORD=change_me
